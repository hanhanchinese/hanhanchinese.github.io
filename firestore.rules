rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // Mỗi học sinh chỉ đọc và ghi được dữ liệu của chính mình.
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Giáo viên (email trong danh sách) được xem kết quả của tất cả học sinh.
      allow read: if request.auth != null && request.auth.token.email_verified
                  && request.auth.token.email in ['email-giao-vien@gmail.com'];
    }
  }
}
